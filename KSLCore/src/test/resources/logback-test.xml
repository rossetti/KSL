<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test logging defaults for KSLCore.

  Tests are quiet by default: only WARN and above reach the console. Routine
  simulation lifecycle, RNG stream, and IO progress is logged at DEBUG/TRACE by
  the library and is intentionally suppressed here. This file takes precedence
  over src/main/resources/logback.xml on the test classpath, which also stops
  test runs from writing the logs/*.log files that config creates.

  To see detailed diagnostics for a focused debugging session, temporarily
  raise a specific logger, e.g.:

      <logger name="ksl.simulation.Model" level="TRACE"/>
      <logger name="ksl.utilities.random.rng.RNStreamProvider" level="DEBUG"/>

  or set the root level to DEBUG. Revert before committing.
-->
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="consoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <Pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{35} - %msg%n</Pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="consoleAppender"/>
    </root>
</configuration>
