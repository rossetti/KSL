<!--
  MCP server logging configuration.

  The MCP stdio transport uses STDOUT as the protocol channel, so ALL logging
  must go to STDERR — a STDOUT appender here would corrupt the MCP stream and
  disconnect the agent.

  This file is uniquely named (not the conventional `logback.xml`) on purpose:
  KSLCore also ships a `logback.xml`, whose root console appender defaults to
  STDOUT. When both are on the classpath, which one Logback auto-selects is not
  deterministic. The server's launcher therefore selects THIS file explicitly
  via `-Dlogback.configurationFile=logback-ksl-mcp.xml` (set in the build's
  `applicationDefaultJvmArgs`), so KSLCore's stdout-logging config can never win.
  McpLoggingConfigTest guards that this file never targets stdout.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
