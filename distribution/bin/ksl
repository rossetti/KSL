#!/usr/bin/env bash
#
# ksl — manage the KSL suite installed in this KSLWork folder.
#
#   ksl list                          what's available and what's installed
#   ksl install <id> [--from <zip>]   add one item (reuses the shared lib/)
#   ksl uninstall <id>                remove one item
#   ksl update [id] [--from <zip>]    refresh everything, or just one item
#   ksl refresh                       rebuild the double-clickable app entry points
#
# <id> comes from the catalog (see `ksl list`): e.g. single, results, mcp, book, kslpkg.
# Without --from, install/update download ksl-suite.zip from the manifest (once a release
# exists); --from <zip> installs from a local ksl-suite.zip. bundles/ and per-app working
# output are never touched.
#
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"     # bin/ksl -> KSLWork
MANIFEST="$ROOT/manifest.json"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

say() { printf '%s\n' "$*"; }
die() { printf 'ksl: %s\n' "$*" >&2; exit 1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

[ -f "$MANIFEST" ] || die "no manifest.json in $ROOT — run this as an installed KSLWork/bin/ksl"

# catalog: one "id<TAB>kind<TAB>path" line per item object in manifest.json
catalog() {
  grep -oE '\{[^{}]*"id"[^{}]*\}' "$MANIFEST" | while read -r o; do
    printf '%s\t%s\t%s\n' \
      "$(printf '%s' "$o" | sed -n 's/.*"id"[^"]*"\([^"]*\)".*/\1/p')" \
      "$(printf '%s' "$o" | sed -n 's/.*"kind"[^"]*"\([^"]*\)".*/\1/p')" \
      "$(printf '%s' "$o" | sed -n 's/.*"path"[^"]*"\([^"]*\)".*/\1/p')"
  done
}
# NB: read all of catalog (no early `exit`) — exiting awk early SIGPIPEs catalog, which
# under `set -o pipefail`/`set -e` would silently kill the script.
path_of() { catalog | awk -F'\t' -v i="$1" '$1==i{r=$3} END{if (r!="") print r}'; }
kind_of() { catalog | awk -F'\t' -v i="$1" '$1==i{r=$2} END{if (r!="") print r}'; }

FROM=""
# echo a usable ksl-suite.zip path: --from if given, else download from the manifest URL
suite_zip() {
  if [ -n "$FROM" ]; then [ -f "$FROM" ] || die "--from: no such file: $FROM"; printf '%s\n' "$FROM"; return; fi
  local url; url="$(sed -n 's/.*"asset"[^"]*"\([^"]*ksl-suite\.zip\)".*/\1/p' "$MANIFEST" | head -1)"
  [ -n "$url" ] || die "no suite URL in manifest and no --from given (publish a release first)"
  printf 'downloading %s ...\n' "$url" >&2
  curl -fSL "$url" -o "$TMP/ksl-suite.zip" >&2 || die "download failed"
  printf '%s\n' "$TMP/ksl-suite.zip"
}
dequarantine() { [ "$(uname)" = "Darwin" ] && xattr -dr com.apple.quarantine "$@" >/dev/null 2>&1 || true; }

# ── entry points ────────────────────────────────────────────────────────────────
# The launchers under Apps/<Name>/ are shell scripts: double-clicking one in Finder
# only opens a Terminal that then babysits the app. These build the real,
# platform-native thing a student double-clicks instead.

# A .app has no visible stdout, so a missing Java 21 must be reported with a native
# dialog — an `echo` here would look exactly like "nothing happened".
make_macos_app() {
  # NB: separate `local` statements — bash expands every word of a `local` line
  # before it performs any assignment, so `local a="$1" b="$a"` leaves b empty
  # (and trips `set -u`).
  local name="$1"
  local app="$ROOT/Applications/$name.app"
  local ver
  ver="$(sed -n 's/.*"version"[^"]*"\([^"]*\)".*/\1/p' "$MANIFEST" | head -1 || true)"
  [ -n "$ver" ] || ver="1.0"
  rm -rf "$app"
  mkdir -p "$app/Contents/MacOS"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>KSL $name</string>
    <key>CFBundleDisplayName</key><string>KSL $name</string>
    <key>CFBundleIdentifier</key><string>io.github.rossetti.ksl.$(lower "$name")</string>
    <key>CFBundleExecutable</key><string>$name</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$ver</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
  cat > "$app/Contents/MacOS/$name" <<'LAUNCHER'
#!/bin/bash
# Generated by the KSL installer — do not edit; `ksl refresh` rewrites it.
NAME="$(basename "$0")"
KSLWORK="$(cd "$(dirname "$0")/../../../.." && pwd)"
JAVA=java
[ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ] && JAVA="$JAVA_HOME/bin/java"
VER="$("$JAVA" -version 2>&1 | head -1 | sed -E 's/.*version "([0-9]+).*/\1/')"
if [ -z "$VER" ] || ! [ "$VER" -ge 21 ] 2>/dev/null; then
  osascript -e "display dialog \"KSL $NAME needs Java 21 — the same JDK you use in IntelliJ.

Install JDK 21, then open KSL $NAME again.\" with title \"KSL $NAME\" buttons {\"OK\"} default button \"OK\" with icon caution" >/dev/null 2>&1
  exit 1
fi
exec "$KSLWORK/Apps/$NAME/$NAME"
LAUNCHER
  chmod +x "$app/Contents/MacOS/$name"
}

make_linux_desktop() {
  local name="$1" dir="$HOME/.local/share/applications"
  mkdir -p "$dir"
  cat > "$dir/ksl-$(lower "$name").desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Version=1.0
Name=KSL $name
Comment=Kotlin Simulation Library — $name
Exec=$ROOT/Apps/$name/$name
Path=$ROOT
Terminal=false
Categories=Education;Science;Development;
DESKTOP
}

make_entry_point() {
  case "$(uname)" in
    Darwin) make_macos_app "$1" ;;
    Linux)  make_linux_desktop "$1" ;;
  esac
}
remove_entry_point() {
  case "$(uname)" in
    Darwin) rm -rf "${ROOT:?}/Applications/$1.app" ;;
    Linux)  rm -f "$HOME/.local/share/applications/ksl-$(lower "$1").desktop" ;;
  esac
}

# The payload is ONE cross-platform zip, so every folder also ships the Windows
# launchers. Drop what this machine can't run — otherwise double-clicking a .cmd
# just asks the student which application should open it.
prune_foreign() {
  find "$ROOT/Apps" "$ROOT/Servers" "$ROOT/Tools" -name '*.cmd' -delete 2>/dev/null || true
  rm -f "$ROOT/bin/ksl.cmd" "$ROOT/bin/ksl.ps1"
}

cmd_refresh() {
  prune_foreign
  local n=0 d
  for d in "$ROOT"/Apps/*/; do
    [ -d "$d" ] || continue
    make_entry_point "$(basename "$d")"
    n=$((n + 1))
  done
  case "$(uname)" in
    Darwin) say "refreshed $n app(s): double-click $ROOT/Applications/<App>.app (or drag it to your Dock)" ;;
    Linux)  say "refreshed $n app(s): look for \"KSL <App>\" in your applications menu" ;;
    *)      say "refreshed $n app(s)" ;;
  esac
}

cmd_list() {
  say "KSLWork: $ROOT"
  [ -f "$ROOT/VERSIONS.txt" ] && grep -iE '^version:' "$ROOT/VERSIONS.txt" || true
  printf '  %-13s %-7s %s\n' "id" "kind" "installed"
  catalog | while IFS="$(printf '\t')" read -r id kind path; do
    if [ -d "$ROOT/$path" ]; then st="yes"; else st="-"; fi
    printf '  %-13s %-7s %s\n' "$id" "$kind" "$st"
  done
}
cmd_uninstall() {
  local path; path="$(path_of "$1")"
  [ -n "$path" ] || die "unknown id: $1 (see 'ksl list')"
  [ -d "$ROOT/$path" ] || { say "$1 is not installed."; return; }
  if [ "$(kind_of "$1")" = "app" ]; then remove_entry_point "$(basename "$path")"; fi
  rm -rf "${ROOT:?}/$path"
  say "removed $1 ($path)"
}
cmd_install() {
  local path; path="$(path_of "$1")"
  [ -n "$path" ] || die "unknown id: $1 (see 'ksl list')"
  local zip; zip="$(suite_zip)"
  unzip -q -o "$zip" "$path/*" -d "$ROOT"
  dequarantine "$ROOT/$path"
  prune_foreign
  if [ "$(kind_of "$1")" = "app" ]; then make_entry_point "$(basename "$path")"; fi
  say "installed $1 -> $path"
}
cmd_update() {
  local zip; zip="$(suite_zip)"
  if [ -z "${1:-}" ]; then
    unzip -q -o "$zip" 'lib/*' 'Apps/*' 'Servers/*' 'Tools/*' 'bin/*' -d "$ROOT"
    dequarantine "$ROOT/Apps" "$ROOT/Servers" "$ROOT/Tools"
    # an update re-extracts the cross-platform zip, so the foreign launchers come
    # back and the entry points must be rebuilt
    cmd_refresh
    say "updated the whole suite (bundles/ and working output preserved)"
  else
    local path; path="$(path_of "$1")"; [ -n "$path" ] || die "unknown id: $1"
    unzip -q -o "$zip" "$path/*" -d "$ROOT"; dequarantine "$ROOT/$path"
    prune_foreign
    if [ "$(kind_of "$1")" = "app" ]; then make_entry_point "$(basename "$path")"; fi
    say "updated $1"
  fi
}

# pull --from out of the args, then dispatch
A=()
while [ $# -gt 0 ]; do case "$1" in --from) FROM="${2:-}"; shift 2 ;; *) A+=("$1"); shift ;; esac; done
set -- ${A[@]+"${A[@]}"}
cmd="${1:-list}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  list)             cmd_list ;;
  install)          [ $# -ge 1 ] || die "usage: ksl install <id> [--from <zip>]"; cmd_install "$1" ;;
  uninstall|remove) [ $# -ge 1 ] || die "usage: ksl uninstall <id>"; cmd_uninstall "$1" ;;
  update)           cmd_update "${1:-}" ;;
  refresh)          cmd_refresh ;;
  help|-h|--help)   say "usage: ksl {list | install <id> | uninstall <id> | update [id] | refresh} [--from <ksl-suite.zip>]" ;;
  *) die "unknown command: $cmd (try 'ksl list')" ;;
esac
