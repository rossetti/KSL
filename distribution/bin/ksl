#!/usr/bin/env bash
#
# ksl — manage the installed KSL suite.
#
#   ksl list                          what's available and what's installed
#   ksl install <id> [--from <zip>]   add one item (reuses the shared lib/)
#   ksl uninstall <id>                remove one item
#   ksl update [id] [--from <zip>]    refresh everything, or just one item
#   ksl refresh                       rebuild the double-clickable app entry points
#
# Two roots, deliberately separate:
#
#   <KSL_HOME>          the SOFTWARE. This script's own home — ~/Applications/KSL on
#                       macOS/Linux. Holds the double-clickable bundles, bin/ksl, and a
#                       hidden .support/ with lib/, the per-app jars + launchers,
#                       Servers/, Tools/ and manifest.json. Owned by the installer.
#
#   <workspace>         YOUR WORK — bundles/, configs, per-app output. Defaults to
#                       ~/Documents/KSLWork, set in ~/.ksl/settings.toml, owned by the
#                       apps. This script never reads or writes it.
#
# <id> comes from the catalog (see `ksl list`): e.g. single, results, mcp, book, kslpkg.
#
set -euo pipefail

KSL_HOME="$(cd "$(dirname "$0")/.." && pwd)"   # bin/ksl -> KSL_HOME
SUPPORT="$KSL_HOME/.support"
MANIFEST="$SUPPORT/manifest.json"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

# Where the CURRENT release is described. $MANIFEST is the copy the installer cached, so it
# describes the release you have — `list` wants that. `update` wants the release that exists
# NOW, which only the published manifest knows. Reading $MANIFEST for both is why `ksl update`
# re-downloaded the version you already had, every time, and reported success.
# Same URL install.sh uses; keep them together.
OWNER_REPO="rossetti/KSL"
MANIFEST_URL="https://raw.githubusercontent.com/${OWNER_REPO}/main/manifest.json"

say() { printf '%s\n' "$*"; }
die() { printf 'ksl: %s\n' "$*" >&2; exit 1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
sha256() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
           else sha256sum "$1" | awk '{print $1}'; fi; }
suite_version_of() { sed -n 's/^[[:space:]]*"suite":.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -1; }

[ -f "$MANIFEST" ] || die "no manifest at $MANIFEST — run this as an installed <KSL_HOME>/bin/ksl"

# The manifest `update` acts on: the published one, or the cached one if we cannot reach the
# network. Falling back is right -- --from installs from a local zip and must work offline --
# but it is announced, because a silent fallback is indistinguishable from an up-to-date install.
UPDATE_MANIFEST=""
update_manifest() {
  if [ -z "$UPDATE_MANIFEST" ]; then
    if [ -n "${FROM:-}" ]; then
      UPDATE_MANIFEST="$MANIFEST"
    elif curl -fsSL "$MANIFEST_URL" -o "$TMP/manifest.json" 2>/dev/null && [ -s "$TMP/manifest.json" ]; then
      UPDATE_MANIFEST="$TMP/manifest.json"
    else
      say "could not reach $MANIFEST_URL — falling back to the manifest cached at install time," >&2
      say "so this can only reinstall $(suite_version_of "$MANIFEST"). Check your connection to get anything newer." >&2
      UPDATE_MANIFEST="$MANIFEST"
    fi
  fi
  printf '%s\n' "$UPDATE_MANIFEST"
}

# catalog: one "id<TAB>kind<TAB>path<TAB>entry<TAB>launcher<TAB>display" line per item
# object in manifest.json. Paths (Apps/Single, Servers/mcp, …) are relative to $SUPPORT.
# entry/launcher/display are empty for items that don't declare them (apps, rest, tool,
# bundles); only the setup-GUI servers carry all three.
catalog() {
  grep -oE '\{[^{}]*"id"[^{}]*\}' "$MANIFEST" | while read -r o; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(printf '%s' "$o" | sed -n 's/.*"id"[^"]*"\([^"]*\)".*/\1/p')" \
      "$(printf '%s' "$o" | sed -n 's/.*"kind"[^"]*"\([^"]*\)".*/\1/p')" \
      "$(printf '%s' "$o" | sed -n 's/.*"path"[^"]*"\([^"]*\)".*/\1/p')" \
      "$(printf '%s' "$o" | sed -n 's/.*"entry"[^"]*"\([^"]*\)".*/\1/p')" \
      "$(printf '%s' "$o" | sed -n 's/.*"launcher"[^"]*"\([^"]*\)".*/\1/p')" \
      "$(printf '%s' "$o" | sed -n 's/.*"display"[^"]*"\([^"]*\)".*/\1/p')"
  done
}
# NB: read all of catalog (no early `exit`) — exiting awk early SIGPIPEs catalog, which
# under `set -o pipefail`/`set -e` would silently kill the script.
path_of()     { catalog | awk -F'\t' -v i="$1" '$1==i{r=$3} END{if (r!="") print r}'; }
kind_of()     { catalog | awk -F'\t' -v i="$1" '$1==i{r=$2} END{if (r!="") print r}'; }
entry_of()    { catalog | awk -F'\t' -v i="$1" '$1==i{r=$4} END{if (r!="") print r}'; }
launcher_of() { catalog | awk -F'\t' -v i="$1" '$1==i{r=$5} END{if (r!="") print r}'; }
display_of()  { catalog | awk -F'\t' -v i="$1" '$1==i{r=$6} END{if (r!="") print r}'; }

# entry_args_for <id>: the makers' args for an item that gets a double-clickable entry
# point — "display<TAB>launcher_rel<TAB>icon_stem<TAB>slug" — or nothing if it gets none.
# Apps derive everything from the dir basename (launcher == icon == name). A setup-GUI
# server (entry == gui) runs its OWN launcher with no args (which opens the setup window)
# and uses the shared `server` icon; its label comes from `display`, its slug is the id.
entry_args_for() {
  local id="$1" kind path
  kind="$(kind_of "$id")"; path="$(path_of "$id")"
  [ -n "$path" ] || return 0
  if [ "$kind" = "app" ]; then
    local name; name="$(basename "$path")"
    printf '%s\t%s\t%s\t%s\n' "$name" "$path/$name" "$path/$name" "$(lower "$name")"
  elif [ "$(entry_of "$id")" = "gui" ]; then
    printf '%s\t%s\t%s\t%s\n' "$(display_of "$id")" "$path/$(launcher_of "$id")" "$path/server" "$id"
  fi
}

FROM=""
suite_zip() {
  if [ -n "$FROM" ]; then [ -f "$FROM" ] || die "--from: no such file: $FROM"; printf '%s\n' "$FROM"; return; fi
  local mf; mf="$(update_manifest)"
  local url sha
  url="$(sed -n 's/.*"asset"[^"]*"\([^"]*ksl-suite\.zip\)".*/\1/p' "$mf" | head -1)"
  sha="$(sed -n 's/.*"sha256"[^"]*"\([0-9a-f]\{64\}\)".*/\1/p' "$mf" | head -1)"
  [ -n "$url" ] || die "no suite URL in manifest and no --from given (publish a release first)"
  printf 'downloading %s ...\n' "$url" >&2
  curl -fSL "$url" -o "$TMP/ksl-suite.zip" >&2 || die "download failed"
  # The installer verifies this and the updater did not, so a truncated or tampered 151 MB
  # download installed silently. Same check, same message.
  if [ -n "$sha" ]; then
    local got; got="$(sha256 "$TMP/ksl-suite.zip")"
    [ "$got" = "$sha" ] || die "sha256 mismatch (expected $sha, got $got)"
    printf 'sha256 verified\n' >&2
  fi
  printf '%s\n' "$TMP/ksl-suite.zip"
}
dequarantine() { [ "$(uname)" = "Darwin" ] && xattr -dr com.apple.quarantine "$@" >/dev/null 2>&1 || true; }

# What `ksl list` reports. install.sh writes this at install time and nothing rewrote it
# afterwards, so the version shown was whatever you FIRST installed. Same fields the installer
# writes, so the two agree whichever one last ran.
write_versions_file() {
  local java="java"
  [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ] && java="$JAVA_HOME/bin/java"
  {
    printf 'KSL suite updated %s\n' "$(date)"
    printf 'software: %s\n' "$KSL_HOME"
    local v; v="$(suite_version_of "$MANIFEST")"
    [ -n "$v" ] && printf 'version: %s\n' "$v"
    printf 'java:    %s\n' "$("$java" -version 2>&1 | head -1)"
    printf 'apps:    %s\n' "$(ls "$SUPPORT/Apps" 2>/dev/null | tr '\n' ' ')"
    printf 'servers: %s\n' "$(ls "$SUPPORT/Servers" 2>/dev/null | tr '\n' ' ')"
  } > "$SUPPORT/VERSIONS.txt"
}

set_plist_string() {
  local plist="$1" key="$2" value="$3"
  /usr/libexec/PlistBuddy -c "Set :$key $value" "$plist" >/dev/null 2>&1 ||
    /usr/libexec/PlistBuddy -c "Add :$key string $value" "$plist" >/dev/null
}

# ── entry points ────────────────────────────────────────────────────────────────
# Built with osacompile, which ships with macOS and emits a REAL universal Mach-O
# applet. That is not cosmetic. A bundle whose executable is a shell script is
# attributed by TCC to /bin/bash, which macOS then silently denies access to
# ~/Documents (no prompt, wherever the bundle lives) — so a script-based bundle
# cannot launch an app whose workspace is ~/Documents/KSLWork, the default. A real
# applet is granted access normally. Do not "simplify" this back to a shell script.
#
# The applet resolves KSL_HOME from its OWN location (`path to me`), so moving or
# renaming ~/Applications/KSL keeps everything working — nothing absolute is baked in.
make_macos_app() {
  local display="$1" launcher_rel="$2" icon_stem="$3" slug="$4"
  local app="$KSL_HOME/KSL $display.app"
  local src="$TMP/$slug.applescript"
  local icon="$SUPPORT/$icon_stem.icns"
  local icon_base; icon_base="$(basename "$icon_stem").icns"
  local plist="$app/Contents/Info.plist"
  local display_name="KSL $display"
  local bundle_id="io.github.rossetti.ksl.$slug"
  local suite_version bundle_version
  suite_version="$(sed -n 's/^[[:space:]]*"suite":.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST")"
  bundle_version="$(printf '%s\n' "$suite_version" | sed -nE 's/^([0-9]+(\.[0-9]+){0,2}).*/\1/p')"
  [ -n "$bundle_version" ] || bundle_version="0"
  [ -f "$icon" ] || die "missing macOS icon for $display_name: $icon"
  rm -rf "$app"
  {
    printf 'set appName to "KSL %s"\n' "$display"
    printf 'set launcherRel to "%s"\n' "$launcher_rel"
    cat <<'APPLESCRIPT'
-- Generated by the KSL installer -- do not edit; `ksl refresh` rewrites it.
set kslHome to do shell script "cd " & quoted form of (POSIX path of (path to me)) & "/.. && pwd"
set launcher to kslHome & "/.support/" & launcherRel
-- This applet backgrounds the app and discards its output, so a broken install would
-- otherwise die in total silence. Say what is wrong instead.
set installed to false
try
    do shell script "test -x " & quoted form of launcher
    set installed to true
end try
if not installed then
    set msg to appName & " cannot find its installation." & return & return & "It expected:" & return & launcher & return & return & "Re-run the KSL installer to fix this."
    display dialog msg with title appName buttons {"OK"} default button "OK" with icon stop
    return
end if
set probe to "J=java; if [ -n \"$JAVA_HOME\" ] && [ -x \"$JAVA_HOME/bin/java\" ]; then J=\"$JAVA_HOME/bin/java\"; fi; \"$J\" -version 2>&1 | head -1 | sed -E 's/.*version \"([0-9]+).*/\\1/'"
set ver to ""
try
    set ver to do shell script probe
end try
set ok to false
try
    if ver is not "" then
        if (ver as integer) >= 21 then set ok to true
    end if
end try
if not ok then
    set msg2 to appName & " needs Java 21 - the same JDK you use in IntelliJ." & return & return & "Install JDK 21, then open " & appName & " again."
    display dialog msg2 with title appName buttons {"OK"} default button "OK" with icon caution
    return
end if
do shell script quoted form of launcher & " > /dev/null 2>&1 &"
APPLESCRIPT
  } > "$src"
  osacompile -o "$app" "$src"
  cp "$icon" "$app/Contents/Resources/$icon_base"
  set_plist_string "$plist" CFBundleIconFile "$icon_base"
  set_plist_string "$plist" CFBundleIdentifier "$bundle_id"
  set_plist_string "$plist" CFBundleName "$display_name"
  set_plist_string "$plist" CFBundleDisplayName "$display_name"
  set_plist_string "$plist" CFBundleShortVersionString "$bundle_version"
  set_plist_string "$plist" CFBundleVersion "$bundle_version"
  # osacompile creates an ad-hoc signature; changing its sealed resources and plist
  # invalidates that signature, so seal the completed applet again.
  codesign --force --deep --sign - "$app" >/dev/null
}

make_linux_desktop() {
  local display="$1" launcher_rel="$2" icon_stem="$3" slug="$4"
  local dir="$HOME/.local/share/applications"
  mkdir -p "$dir"
  cat > "$dir/ksl-$slug.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Version=1.0
Name=KSL $display
Comment=Kotlin Simulation Library — $display
Exec=$SUPPORT/$launcher_rel
Icon=$SUPPORT/$icon_stem-256.png
Terminal=false
Categories=Education;Science;Development;
DESKTOP
}

# make/remove an entry point by item <id>. No-ops for items that get none (entry_args_for
# is empty), so callers can invoke these unconditionally.
make_entry_point() {
  local args; args="$(entry_args_for "$1")"
  [ -n "$args" ] || return 0
  local display launcher_rel icon_stem slug
  IFS=$'\t' read -r display launcher_rel icon_stem slug <<<"$args"
  case "$(uname)" in
    Darwin) make_macos_app    "$display" "$launcher_rel" "$icon_stem" "$slug" ;;
    Linux)  make_linux_desktop "$display" "$launcher_rel" "$icon_stem" "$slug" ;;
  esac
}
remove_entry_point() {
  local args; args="$(entry_args_for "$1")"
  [ -n "$args" ] || return 0
  local display _lr _is slug
  IFS=$'\t' read -r display _lr _is slug <<<"$args"
  case "$(uname)" in
    Darwin) rm -rf "${KSL_HOME:?}/KSL $display.app" ;;
    Linux)  rm -f "$HOME/.local/share/applications/ksl-$slug.desktop" ;;
  esac
}

# Best-effort: PIDs of processes whose command line points into $1 — a KSL server process (the
# suite, or a stdio bridge a client spawned) keeps files there open. Empty when none, or when
# pgrep is unavailable. `|| true` keeps set -e / pipefail from tripping on no match.
active_processes_using() {
  command -v pgrep >/dev/null 2>&1 || return 0
  pgrep -f "$1" 2>/dev/null || true
}

# A gui server (entry == "gui"): run its launcher --remove to strip that server's MCP entry —
# the suite's `ksl-suite` entry — from detected agents (Codex / Claude Desktop). Must precede any
# delete (the launcher must still exist). Best-effort. Returns 0 if attempted, 1 if not a gui
# server or no launcher. Note: --remove edits config only; a live client keeps running until it
# restarts.
unregister() {
  [ "$(entry_of "$1")" = "gui" ] || return 1
  local path launcher; path="$(path_of "$1")"; launcher="$(launcher_of "$1")"
  local exe="$SUPPORT/$path/$launcher"
  [ -x "$exe" ] || { say "note: $1 has no launcher at $exe; skipping client unregister (use its setup app)."; return 1; }
  say "unregistering $1 from detected agents (Codex / Claude Desktop) ..."
  "$exe" --remove 2>&1 | sed 's/^/  /' || say "  warning: --remove failed; remove the entry with the setup app instead."
  return 0
}

# The payload is ONE cross-platform zip, so .support/ also receives the Windows
# launchers. Drop what this machine can't run.
prune_foreign() {
  find "$SUPPORT/Apps" "$SUPPORT/Servers" "$SUPPORT/Tools" -name '*.cmd' -delete 2>/dev/null || true
  rm -rf "$SUPPORT/bin"
}

# Delete anything in lib/ the payload did not just deliver. `unzip -o` overwrites what the zip holds
# and removes nothing else, so jars dropped between releases accumulate: 0.3.3 -> 0.3.4 left
# KSLCore-R1.4.jar beside KSLCore-R1.5.1.jar. Launchers put the directory on the classpath with
# `lib/*`, and the JVM does not specify that expansion's order -- so with two versions of a class
# present, which one wins is not something a release controls.
#
# Only lib/ is pruned this way. It is deliberately absent from the catalog because nothing in it is
# independently installable, so nothing here can reflect a user's choice; Apps/, Servers/ and Tools/
# hold exactly such choices and pruning them against the payload would undo an `ksl uninstall`.
# Derived from the zip, not a list to keep in step, and run after extraction so a failure cannot
# leave an install with no lib/.
prune_stale_lib() {  # $1 = the payload zip
  [ -d "$SUPPORT/lib" ] || return 0
  unzip -Z1 "$1" 'lib/*' 2>/dev/null | sed 's|^lib/||' | grep . | sort > "$TMP/lib-shipped" || return 0
  # No listing means the query failed, not that the payload ships nothing: pruning on that reading
  # would empty lib/ and leave nothing runnable.
  [ -s "$TMP/lib-shipped" ] || return 0
  ls -1 "$SUPPORT/lib" 2>/dev/null | sort > "$TMP/lib-present"
  local n=0 stale
  while IFS= read -r stale; do
    [ -n "$stale" ] || continue
    rm -f "$SUPPORT/lib/$stale" && n=$((n + 1))
  done < <(comm -13 "$TMP/lib-shipped" "$TMP/lib-present")
  [ "$n" -gt 0 ] && say "removed $n stale jar(s) left by an earlier release"
  return 0
}

cmd_refresh() {
  prune_foreign
  local n=0 id kind path entry launcher display
  # Entry points exist for the desktop apps and the setup-GUI servers (entry == gui),
  # when installed. Process substitution (not a pipe) keeps $n in this shell.
  while IFS=$'\t' read -r id kind path entry launcher display; do
    { [ "$kind" = "app" ] || [ "$entry" = "gui" ]; } || continue
    [ -d "$SUPPORT/$path" ] || continue
    make_entry_point "$id"
    n=$((n + 1))
  done < <(catalog)
  case "$(uname)" in
    Darwin) say "refreshed $n entry point(s): find \"KSL <Name>\" in Launchpad, or $KSL_HOME" ;;
    Linux)  say "refreshed $n entry point(s): look for \"KSL <Name>\" in your applications menu" ;;
    *)      say "refreshed $n entry point(s)" ;;
  esac
}

cmd_list() {
  say "KSL software: $KSL_HOME"
  [ -f "$SUPPORT/VERSIONS.txt" ] && grep -iE '^version:' "$SUPPORT/VERSIONS.txt" || true
  printf '  %-13s %-7s %s\n' "id" "kind" "installed"
  catalog | while IFS="$(printf '\t')" read -r id kind path entry launcher display; do
    if [ -d "$SUPPORT/$path" ]; then st="yes"; else st="-"; fi
    printf '  %-13s %-7s %s\n' "$id" "$kind" "$st"
  done
}
cmd_uninstall() {
  local path; path="$(path_of "$1")"
  [ -n "$path" ] || die "unknown id: $1 (see 'ksl list')"
  local full="${SUPPORT:?}/$path"
  [ -d "$full" ] || { say "$1 is not installed."; return; }

  # Strip the client config entry before deleting files (the launcher must still exist for
  # --remove to run). Only edits config — a live client keeps running until it restarts, which
  # the preflight below then requires. --keep-config skips this.
  if [ "${KEEP_CONFIG:-}" != "1" ] && unregister "$1"; then
    say "if a server JVM is still running, restart Codex / Claude Desktop so it exits, then re-run."
  fi

  # Preflight: a running KSL server process (the suite, or a stdio bridge a client spawned) keeps
  # files under $full open. On Windows the delete would fail; on macOS/Linux it "succeeds" but
  # orphans the JVM and leaves the client config pointing at deleted paths. Either way, stop and
  # let the user close the client first, so uninstall behaves the same on both platforms. Report
  # only — never kill.
  local pids; pids="$(active_processes_using "$full")"
  if [ -n "$pids" ]; then
    say "cannot uninstall $1 — these processes are still using it:"
    local pid
    for pid in $pids; do
      ps -o pid=,args= -p "$pid" 2>/dev/null | sed 's/^/  /' || printf '  %s\n' "$pid"
    done
    die "close Codex, Claude Desktop, and any running KSL apps or servers, then try again. For an MCP server, first remove its entry with the setup app (or the server's --remove)."
  fi

  # Delete the files FIRST, the entry point SECOND — mirror the Windows twin so a failed
  # delete never removes the app/desktop entry while the files remain.
  rm -rf "$full" || die "could not remove $full. Close Codex, Claude Desktop, and any running KSL apps or servers, then try again."
  remove_entry_point "$1"
  say "removed $1 ($path)"
}
cmd_unregister() {
  [ -n "$(path_of "$1")" ] || die "unknown id: $1 (see 'ksl list')"
  unregister "$1" || say "$1 is not an MCP setup server; nothing to unregister."
}
cmd_uninstall_suite() {
  if [ "${YES:-}" != "1" ]; then
    say "This removes the entire KSL software install at:"
    say "  $KSL_HOME"
    say "Your work in KSLWork is NOT touched. Re-run 'ksl uninstall-suite --yes' to proceed."
    return
  fi
  # 1. Unregister every installed MCP setup server from Codex / Claude (needs the launchers, so
  #    it must run before the delete).
  if [ "${KEEP_CONFIG:-}" != "1" ]; then
    while IFS=$'\t' read -r id kind path entry launcher display; do
      [ "$entry" = "gui" ] && [ -d "$SUPPORT/$path" ] && unregister "$id" || true
    done < <(catalog)
  fi
  # 2. Stop if any KSL server JVM is still using the install.
  local pids; pids="$(active_processes_using "$SUPPORT")"
  if [ -n "$pids" ]; then
    say "cannot remove the suite — these processes are still using it:"
    local pid
    for pid in $pids; do ps -o pid=,args= -p "$pid" 2>/dev/null | sed 's/^/  /' || printf '  %s\n' "$pid"; done
    die "restart Codex / Claude Desktop and close any KSL apps, then re-run 'ksl uninstall-suite --yes'."
  fi
  # 3. Remove entry points (Linux .desktop live outside KSL_HOME; macOS .app go with the dir below).
  while IFS=$'\t' read -r id kind path entry launcher display; do
    { [ "$kind" = "app" ] || [ "$entry" = "gui" ]; } && remove_entry_point "$id" || true
  done < <(catalog)
  # 4. Delete the whole software dir. Unlike the Windows twin, rm -rf works on our own $KSL_HOME
  #    here — the running script's inode stays open until we exit — and KSLWork lives elsewhere.
  rm -rf "${KSL_HOME:?}"
  say "removed the KSL software (your KSLWork is untouched)"
}
cmd_install() {
  local path; path="$(path_of "$1")"
  [ -n "$path" ] || die "unknown id: $1 (see 'ksl list')"
  local zip; zip="$(suite_zip)"
  unzip -q -o "$zip" "$path/*" -d "$SUPPORT"
  dequarantine "$SUPPORT/$path"
  prune_foreign
  make_entry_point "$1"
  say "installed $1 -> $path"
}
cmd_update() {
  local zip; zip="$(suite_zip)"
  if [ -z "${1:-}" ]; then
    # Extract EVERYTHING, exactly as install.sh does, then relocate the two things that do not
    # live under .support. The old code named the top-level directories one by one -- and named
    # 'bundles/*', which stopped existing when the shipped examples moved to examples/ in 0.3.0.
    # So an update extracted a directory that was not there and skipped the one that was: the
    # bundles and polished layouts were never refreshed, and unzip's "filename not matched"
    # caution was the only sign. A list that must be kept in step with the payload will drift
    # again; not having one cannot.
    unzip -q -o "$zip" -d "$SUPPORT"
    prune_stale_lib "$zip"
    # Replace this very script by rename, never by overwrite: bash reads a script
    # incrementally, so truncating it mid-run corrupts execution. `mv` swaps the
    # directory entry and leaves the running process on the old inode.
    if [ -f "$SUPPORT/bin/ksl" ]; then
      chmod +x "$SUPPORT/bin/ksl"
      mv -f "$SUPPORT/bin/ksl" "$KSL_HOME/bin/ksl"
    fi
    [ -f "$SUPPORT/bin/ksl.ps1" ] && mv -f "$SUPPORT/bin/ksl.ps1" "$KSL_HOME/bin/ksl.ps1"
    [ -f "$SUPPORT/bin/ksl.cmd" ] && mv -f "$SUPPORT/bin/ksl.cmd" "$KSL_HOME/bin/ksl.cmd"
    rm -rf "$SUPPORT/bin"
    # Content, not plumbing -- and owned by the installer, so an update replaces it wholesale.
    # Same placement install.sh gives it.
    if [ -d "$SUPPORT/examples" ]; then
      rm -rf "$KSL_HOME/examples"
      mv -f "$SUPPORT/examples" "$KSL_HOME/examples"
    fi
    # Extracting the whole zip is NOT enough on its own for anything that lives in the visible
    # root: it lands in .support and has to be moved out, exactly as install.sh moves it. Miss the
    # move and the update reports success while leaving the previous release's copy in place --
    # the same silent no-op the 0.3.0 examples/ miss produced, in a different disguise.
    if [ -d "$SUPPORT/skills" ]; then
      rm -rf "$KSL_HOME/skills"
      mv -f "$SUPPORT/skills" "$KSL_HOME/skills"
    fi
    [ -f "$SUPPORT/README.md" ] && mv -f "$SUPPORT/README.md" "$KSL_HOME/README.md"
    # Adopt the manifest we just updated to, BEFORE refreshing: cmd_refresh reads the catalog,
    # and a release that adds an app must have it appear here.
    local mf; mf="$(update_manifest)"
    [ "$mf" = "$MANIFEST" ] || cp -f "$mf" "$MANIFEST"
    dequarantine "$SUPPORT"
    cmd_refresh
    # Nothing rewrote this after install, so `ksl list` reported the version you first installed
    # no matter how many times you updated.
    write_versions_file
    say "updated the whole suite to $(suite_version_of "$MANIFEST") (your workspace was not touched)"
  else
    local path; path="$(path_of "$1")"; [ -n "$path" ] || die "unknown id: $1"
    unzip -q -o "$zip" "$path/*" -d "$SUPPORT"; dequarantine "$SUPPORT/$path"
    prune_foreign
    make_entry_point "$1"
    say "updated $1"
  fi
}

# pull --from out of the args, then dispatch
A=()
while [ $# -gt 0 ]; do case "$1" in --from) FROM="${2:-}"; shift 2 ;; --keep-config) KEEP_CONFIG=1; shift ;; --yes|-y) YES=1; shift ;; *) A+=("$1"); shift ;; esac; done
set -- ${A[@]+"${A[@]}"}
cmd="${1:-list}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  list)             cmd_list ;;
  install)          [ $# -ge 1 ] || die "usage: ksl install <id> [--from <zip>]"; cmd_install "$1" ;;
  uninstall|remove) [ $# -ge 1 ] || die "usage: ksl uninstall <id> [--keep-config]"; cmd_uninstall "$1" ;;
  unregister)       [ $# -ge 1 ] || die "usage: ksl unregister <id>"; cmd_unregister "$1" ;;
  uninstall-suite)  cmd_uninstall_suite ;;
  update)           cmd_update "${1:-}" ;;
  refresh)          cmd_refresh ;;
  help|-h|--help)   say "usage: ksl {list | install <id> | uninstall <id> [--keep-config] | unregister <id> | uninstall-suite --yes | update [id] | refresh} [--from <ksl-suite.zip>]" ;;
  *) die "unknown command: $cmd (try 'ksl list')" ;;
esac
